{
  "name": "@sekina/typed-fetch",
  "version": "0.1.0",
  "description": "A tiny typed fetch wrapper: generics, typed query params, and a discriminated-union Result that never throws.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \".test-out/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": ["fetch", "typescript", "http", "result", "discriminated-union"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
